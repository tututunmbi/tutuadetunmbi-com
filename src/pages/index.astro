---
import Layout from '../layouts/Layout.astro';
import Subscribe from '../components/Subscribe.astro';
import { getCollection } from 'astro:content';

// Pull latest published memos for the homepage teaser
const memos = (await getCollection('memos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Press / media features (hand-curated)
type PressItem = {
  outlet: string;
  title: string;
  excerpt: string;
  image: string;
  url: string;
  kind: 'article' | 'video';
};
const press: PressItem[] = [
  {
    outlet: 'Vanguard Nigeria',
    title: "We expanded to Zambia to accelerate Africa's place in global digital economy",
    excerpt: "Stamfordham, a global leader in integrated marketing communications, has expanded its operations into Zambia, marking a significant step in its mission to strengthen its presence across Africa.",
    image: 'https://cdn.vanguardngr.com/wp-content/uploads/2025/03/image-202-e1741694060980-1024x755.png',
    url: 'https://www.vanguardngr.com/2025/03/we-expanded-to-zambia-to-accelerate-africas-place-in-global-digital-economy-ceo-stamfordham/',
    kind: 'article',
  },
  {
    outlet: 'The Guardian Nigeria',
    title: 'Digital Professional Fair to boost careers, startups, scaleups',
    excerpt: 'The Digital Professional Fair is set to debut in Lagos this August in a move to position itself as a flagship gathering for emerging talent.',
    image: 'https://cdn.guardian.ng/wp-content/uploads/2025/07/IMG_91061-scaled.jpg',
    url: 'https://guardian.ng/technology/tech/digital-professional-fair-to-boost-careers-startups-scaleups/',
    kind: 'article',
  },
  {
    outlet: 'YouTube · Kennedy Ekezie',
    title: 'Who Are You Without the Titles: Tutu Adetunmbi on Becoming',
    excerpt: 'A long-form conversation on the Limitless Series. Identity, becoming, and the work beneath the work.',
    image: 'https://i.ytimg.com/vi/CqHtpeiF064/hqdefault.jpg',
    url: 'https://www.youtube.com/watch?v=CqHtpeiF064',
    kind: 'video',
  },
  {
    outlet: 'Business Africa Online',
    title: "Creativity, Data, and Innovation: Tutu Adetunmbi's Vision for Africa's Marketing Future",
    excerpt: 'On leading transformative strategies that fuel business growth, supercharge brand visibility, and drive client success across Africa.',
    image: 'https://businessafricaonline.com/wp-content/uploads/2024/11/IMG_8168-Edit-scaled-e1732958940458-1000x600.jpg',
    url: 'https://businessafricaonline.com/creativity-data-and-innovation-tutu-adetunmbis-vision-for-africas-marketing-future-with-stamfordham/',
    kind: 'article',
  },
  {
    outlet: 'Exquisite Magazine',
    title: 'Lead Strategist and Founder of The Stamfordham Brand',
    excerpt: 'On being a trailblazing force in the dynamic realm of digital marketing and technology, and the work of spearheading a creative revolution.',
    image: 'https://i0.wp.com/exquisitemag.com/wp-content/uploads/2023/09/F06CB3F4-B298-47E7-B6DD-F991E8E39D24.png',
    url: 'https://exquisitemag.com/tutu-adetumbi-lead-strategist-and-founder-of-stamfordham-brand/',
    kind: 'article',
  },
  {
    outlet: 'YouTube',
    title: 'A Lucrative Career In Marketing In Nigeria Requires Flexibility',
    excerpt: 'On building a marketing career in Nigeria. Flexibility, structure, and what young creatives often miss.',
    image: 'https://i.ytimg.com/vi/03HuCgq8gqU/hqdefault.jpg',
    url: 'https://www.youtube.com/watch?v=03HuCgq8gqU',
    kind: 'video',
  },
];

// Fetch latest YouTube videos at build time (skip Shorts)
const YT_CHANNEL_ID = 'UCbpCskTqAxoU-U1Z0EaPyWA';
type Video = { id: string; title: string };
let videos: Video[] = [
  // Fallback used only if the RSS fetch fails at build time
  { id: 'KCnHdJGTQWI', title: 'My Creative Agency Died. I Killed It.' },
  { id: 'huBbL1WAB9w', title: 'Everyone Is a CEO. Nobody Is Building a Company.' },
  { id: 'pKBAeneGAwY', title: "You're Not Failing. You're Just Building as the Wrong Version of Yourself." },
];
try {
  const res = await fetch(`https://www.youtube.com/feeds/videos.xml?channel_id=${YT_CHANNEL_ID}`);
  if (res.ok) {
    const xml = await res.text();
    const entries = Array.from(xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)).map((m) => m[1]);
    const parsed: Video[] = [];
    for (const e of entries) {
      const linkMatch = e.match(/<link rel="alternate" href="([^"]+)"/);
      if (linkMatch && linkMatch[1].includes('/shorts/')) continue; // skip Shorts
      const idMatch = e.match(/<yt:videoId>([^<]+)<\/yt:videoId>/);
      const titleMatch = e.match(/<title>([^<]+)<\/title>/);
      if (idMatch && titleMatch) {
        parsed.push({ id: idMatch[1], title: titleMatch[1] });
      }
      if (parsed.length >= 3) break;
    }
    if (parsed.length > 0) videos = parsed;
  }
} catch {
  // Use fallback above
}
---
<Layout current="home">

  <!-- INTRO -->
  <section class="home-intro">
    <div class="home-intro-text">
      <h1>Build, or be built upon.</h1>
      <p class="tagline">Memos on work, identity, ownership, and ideology. From the woman building corporate creative institutions.</p>
      <p class="lede">I am a Creative Industrialist and Strategic Operator shaping the future of work, identity, and enterprise within Africa's digital economy. Founder & Principal Consultant of The Stamfordham, Founder, CorpCi International, and the Convener of the Digital Professional Fair.</p>
      <a href="#about" class="read-more">Read more →</a>

      <div class="home-intro-socials">
        <a href="mailto:info@tutuadetunmbi.com">info@tutuadetunmbi.com</a>
        <a href="https://tutuadetunmbi.substack.com" target="_blank" rel="noopener">substack</a>
        <a href="https://www.instagram.com/tutu.adetunmbi" target="_blank" rel="noopener">instagram</a>
        <a href="https://www.youtube.com/@Tutu.Adetunmbi" target="_blank" rel="noopener">youtube</a>
        <a href="https://www.linkedin.com/in/tutuadetunmbi" target="_blank" rel="noopener">linkedin</a>
      </div>
    </div>
    <div class="home-portrait">
      <img src="/tutu-about.png" alt="Tutu Adetunmbi" />
    </div>
  </section>

  <!-- I. MEMOS -->
  <section class="home-section home-section--memos" id="memos">
    <img class="memos-book-deco" src="/book.png" alt="" aria-hidden="true" />
    <div class="section-numeral">i.</div>
    <div>
      <h2>Memos.</h2>
      <ol class="home-memo-list">
        {memos.map((m) => (
          <li>
            <a href={`/memos/${m.id}/`}>
              <div class="thumb">
                {m.data.cover && <img src={m.data.cover} alt={m.data.coverAlt ?? m.data.title} />}
              </div>
              <div class="title">{m.data.title}</div>
              <div class="date">{formatDate(m.data.pubDate)}</div>
            </a>
          </li>
        ))}
      </ol>
      <a href="/memos" class="section-cta">Read all memos →</a>
    </div>
  </section>

  <!-- II. ABOUT -->
  <section class="home-section" id="about">
    <div class="section-numeral">ii.</div>
    <div>
      <h2>Hi, I'm Tutu.</h2>
      <p style="font-size: 1.05rem; color: var(--black); font-style: italic; margin-bottom: 1.5rem;">My life is proof of concept.</p>
      <p>In a decade, I went from being known as "The Digital Tinker" to building the corporate architecture the creative economy is missing. I run a strategic consultancy, an infrastructure firm, and a national gathering for digital professionals. I did it without outside capital, without a co-founder, and without permission.</p>
      <p>I am the Founder & Principal Consultant at <a href="https://stamfordham.com" target="_blank" rel="noopener" style="color:var(--dark);text-decoration:underline;text-underline-offset:2px;">The Stamfordham</a>, a strategic consultancy that acts as the custodian of a founder's vision. Beyond strategy, I am the Founder of <a href="#" style="color:var(--dark);text-decoration:underline;text-underline-offset:2px;">CorpCi International</a>, a boutique infrastructure firm designed to solve the structural deficit in the creative economy. I build the "Factory" behind the "Creative". The corporate governance, systems, and institutional blueprints that allow creative enterprises to survive the founder and scale into legacy organisations.</p>
      <p>At my core, I am a Liberator, determined to re-program a programmed generation, helping them shift trajectories from "digital slaves" to high-agency investors. I build tools that allow African talent to achieve in one year what took previous generations ten.</p>
      <p style="font-size: 0.85rem; color: var(--light-grey); font-style: italic; margin-top: 1.5rem;">Trusted by: Mitsubishi Motors, ORIKI Group, Loreal Luxe, Delta Soap, Whitley Neill Gin, Cascador, BBC Africa, Jobberman, Hayat Kimya, Coca-Cola, The Economist, Emerging Africa, and more.</p>
    </div>
  </section>

  <!-- III. WATCH -->
  <section class="home-section" id="watch">
    <div class="section-numeral">iii.</div>
    <div>
      <h2>Watch.</h2>
      <p>The memos go deep. The videos let you sit with me while I think out loud.</p>
      <div class="yt-grid" style="margin-top: 2rem;">
        {videos.map((v) => (
          <div class="yt-video-card">
            <div class="yt-embed-wrap">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}`}
                title={v.title}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="yt-video-title">{v.title}</div>
          </div>
        ))}
      </div>
      <a href="https://www.youtube.com/@Tutu.Adetunmbi?sub_confirmation=1" target="_blank" rel="noopener" class="section-cta">Subscribe on YouTube →</a>
    </div>
  </section>

  <!-- IV. PRESS -->
  <section class="home-section" id="press">
    <div class="section-numeral">iv.</div>
    <div>
      <h2>Press.</h2>
      <p>Conversations, interviews, and features across African business and creative media.</p>
      <div class="press-grid">
        {press.map((p) => (
          <a class="press-card" href={p.url} target="_blank" rel="noopener">
            <div class="press-thumb">
              <img src={p.image} alt={p.title} loading="lazy" />
              {p.kind === 'video' && <div class="press-kind-badge">▶ Watch</div>}
            </div>
            <div class="press-body">
              <div class="press-outlet">{p.outlet}</div>
              <div class="press-title">{p.title}</div>
              <div class="press-excerpt">{p.excerpt}</div>
              <div class="press-cta">Read →</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- V. TDPF -->
  <section class="home-section" id="tdpf">
    <div class="section-numeral">v.</div>
    <div>
      <h2>The Digital Professional Fair.</h2>
      <p>A landmark gathering I convene to connect talent, tools, and capital, accelerating Africa's participation in the global digital workforce.</p>
      <a href="https://thedigitalprofessionalfair.com" target="_blank" rel="noopener" class="section-cta">Visit TDPF →</a>
    </div>
  </section>

  <!-- VI. CHANNELS -->
  <section class="home-section" id="channels">
    <div class="section-numeral">vi.</div>
    <div>
      <h2>Find me everywhere.</h2>
      <p>I build in public across every platform. The memos go deepest. Everything else is the journey in real time.</p>
      <div class="channels-grid">
        <a href="https://www.youtube.com/@Tutu.Adetunmbi" target="_blank" rel="noopener" class="channel-link yt">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
          YouTube
        </a>
        <a href="https://www.instagram.com/tutu.adetunmbi" target="_blank" rel="noopener" class="channel-link ig">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zM12 0C8.7 0 8.3 0 7.1.1 5.8.1 4.9.3 4.1.6c-.8.3-1.5.7-2.2 1.4C1.3 2.6.9 3.3.6 4.1.3 4.9.1 5.8.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.2 2.2.5 2.9.3.8.7 1.5 1.4 2.2.7.7 1.4 1.1 2.2 1.4.8.3 1.6.5 2.9.5C8.3 24 8.7 24 12 24s3.7 0 4.9-.1c1.3-.1 2.2-.2 2.9-.5.8-.3 1.5-.7 2.2-1.4.7-.7 1.1-1.4 1.4-2.2.3-.8.5-1.6.5-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.3-.2-2.2-.5-2.9-.3-.8-.7-1.5-1.4-2.2-.7-.7-1.4-1.1-2.2-1.4-.8-.3-1.6-.5-2.9-.5C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.5a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z"/></svg>
          Instagram
        </a>
        <a href="https://www.tiktok.com/@tutu.adetunmbi" target="_blank" rel="noopener" class="channel-link tt">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.3 5.8A4.6 4.6 0 0 1 16.2 2h-3.4v13.5a2.8 2.8 0 1 1-2-2.7V9.3a6.3 6.3 0 1 0 5.4 6.2V9.8a8 8 0 0 0 4.6 1.5V7.8a4.6 4.6 0 0 1-1.5-2z"/></svg>
          TikTok
        </a>
        <a href="https://www.linkedin.com/in/tutuadetunmbi" target="_blank" rel="noopener" class="channel-link li">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3v9zM6.5 8.5A1.75 1.75 0 1 1 6.5 5a1.75 1.75 0 0 1 0 3.5zM20 19h-3v-4.7c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.5V19h-3v-9h2.9v1.2h0a3.2 3.2 0 0 1 2.9-1.6c3.1 0 3.7 2 3.7 4.7V19z"/></svg>
          LinkedIn
        </a>
        <a href="https://x.com/TutuAdetunmbi" target="_blank" rel="noopener" class="channel-link xw">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.2 2h3.5l-7.7 8.8L23 22h-7.1l-5.5-7.2L4.6 22H1.1l8.2-9.4L.8 2h7.3l5 6.6L18.2 2zm-1.2 18h2L7 4H4.8l12.2 16z"/></svg>
          X / Twitter
        </a>
        <a href="https://www.threads.com/@tutu.adetunmbi" target="_blank" rel="noopener" class="channel-link th">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.2 2C6.8 2 4 5.5 4 9.5v5C4 18.5 6.8 22 12.2 22c5.3 0 7.8-3.5 7.8-7.5 0-3.5-1.8-5.8-5-6.7a4 4 0 0 0-3.8-2.3c-1.8 0-3.2 1-3.6 2.6l1.6.5c.2-.9.9-1.5 2-1.5 1.5 0 2.5 1 2.8 2.5-1-.2-2-.2-2.8-.2-3 0-5 1.5-5 3.8 0 2.2 1.7 3.5 4 3.5 2 0 3.5-1 4.2-2.8.3.8.5 1.5.5 2.5 0 3-1.8 5.5-5.8 5.5-4.2 0-6.2-3-6.2-6v-5c0-3 2-5.5 6.2-5.5 2 0 3.5.5 4.5 1.2l1-1.5C15.5 2.8 14 2 12.2 2zm1 8.5c1 .1 1.8.2 2.5.4.1.8.2 1.5.2 2.2 0 2-1 3.5-2.8 3.5-1.3 0-2.2-.7-2.2-2 0-1.5 1.2-2.3 3-2.3.4 0 .8 0 1.2.1z"/></svg>
          Threads
        </a>
      </div>
    </div>
  </section>

  <!-- VII. SUBSCRIBE -->
  <section class="home-section" id="subscribe">
    <div class="section-numeral">vii.</div>
    <div>
      <h2>Subscribe to my memos.</h2>
      <p>Every Saturday I share what I am learning, building, and noticing as I live, work, and build. Free. Unfiltered. From the inside.</p>
      <div style="margin-top: 1.5rem;">
        <Subscribe />
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var container = document.getElementById('yt-feed');
      if (!container) return;
      var fallback = [{ id: 'pKBAeneGAwY', title: "You're Not Failing. You're Just Building as the Wrong Version of Yourself." }];

      function render(videos) {
        container.innerHTML = videos.map(function (v) {
          return '<div class="yt-video-card">' +
            '<div class="yt-embed-wrap">' +
              '<iframe src="https://www.youtube.com/embed/' + v.id + '" ' +
              'title="' + v.title.replace(/"/g, '&quot;') + '" ' +
              'frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" ' +
              'allowfullscreen loading="lazy"></iframe>' +
            '</div>' +
            '<div class="yt-video-title">' + v.title + '</div>' +
          '</div>';
        }).join('');
      }
      render(fallback);
    })();
  </script>

</Layout>
