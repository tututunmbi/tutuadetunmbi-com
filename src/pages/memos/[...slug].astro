---
import Layout from '../../layouts/Layout.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const memos = await getCollection('memos', ({ data }) => !data.draft);
  return memos.map((memo) => ({
    params: { slug: memo.id },
    props: { memo },
  }));
}

const { memo } = Astro.props;
const { Content } = await render(memo);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Share URLs for social platforms
const memoUrl = `https://tutuadetunmbi.com/memos/${memo.id}/`;
const shareText = `${memo.data.title} by Tutu Adetunmbi`;
const xShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(memoUrl)}`;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(memoUrl)}`;
const whatsAppShareUrl = `https://wa.me/?text=${encodeURIComponent(shareText + ' ' + memoUrl)}`;
const emailShareUrl = `mailto:?subject=${encodeURIComponent(memo.data.title)}&body=${encodeURIComponent(shareText + '\n\n' + memoUrl)}`;
---
<Layout
  title={`${memo.data.title} · Tutu Adetunmbi`}
  description={memo.data.description}
  current="memos"
  ogImage={memo.data.cover ?? '/tutu-about.png'}
>
  <article class="memo-page">
    <header class="memo-header">
      <div class="eyebrow">Memo</div>
      <h1>{memo.data.title}</h1>
      <div class="memo-meta">
        <span>{formatDate(memo.data.pubDate)}</span>
        {memo.data.substackUrl && (
          <>
            <span class="dot">·</span>
            <a href={memo.data.substackUrl} target="_blank" rel="noopener" style="color: var(--light-grey); text-decoration: none; border-bottom: 1px solid var(--lighter); padding-bottom: 1px;">Read on Substack</a>
          </>
        )}
      </div>
    </header>

    {memo.data.cover && (
      <img class="memo-cover-img" src={memo.data.cover} alt={memo.data.coverAlt ?? memo.data.title} />
    )}

    <div class="memo-body">
      <Content />
    </div>

    <div class="memo-share">
      <span class="memo-share-label">Share this memo</span>
      <div class="memo-share-links">
        <a href={xShareUrl} target="_blank" rel="noopener" aria-label="Share on X / Twitter" title="Share on X">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href={linkedInShareUrl} target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="Share on LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href={whatsAppShareUrl} target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="Share on WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>
        <a href={emailShareUrl} aria-label="Share by email" title="Share by email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2zm-2 0l-8 5-8-5h16zm0 12H4V8l8 5 8-5z"/></svg>
        </a>
        <button class="memo-share-copy" data-url={memoUrl} aria-label="Copy link" title="Copy link to clipboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
          <span class="memo-share-copy-label">Copy link</span>
        </button>
      </div>
    </div>

    <div class="memo-footer">
      <a href="/memos">&larr; All memos</a>
      <a href="/#about">About Tutu</a>
    </div>

    <script is:inline>
      (function () {
        const btn = document.querySelector('.memo-share-copy');
        if (!btn) return;
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url');
          try {
            await navigator.clipboard.writeText(url);
            const label = btn.querySelector('.memo-share-copy-label');
            const original = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => { label.textContent = original; }, 1500);
          } catch (e) {
            // Fallback if clipboard API blocked
            prompt('Copy this URL:', url);
          }
        });
      })();
    </script>

    <div class="memo-subscribe-block">
      <h3>Get the next memo first.</h3>
      <p>Saturdays. Direct to your inbox. Free.</p>
      <Subscribe note="Join the builders. No spam. Unsubscribe anytime." />
    </div>
  </article>
</Layout>
